<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 应用主题：现代蓝色系，无 ActionBar -->
    <style name="Theme.Timetable" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色 -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 强调色 -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/blue_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 状态栏 -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- 导航栏 -->
        <item name="android:navigationBarColor">?attr/colorPrimaryVariant</item>
        <!-- 系统栏浅色图标（白底深色图标） -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
