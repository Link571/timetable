<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:id="@+id/timetable_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/week_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#B3FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_week_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/timetable_nav_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#B3FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/hsv_timetable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingHorizontal="6dp"
            android:paddingTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_row"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/timetable_header_height"
                    android:background="?attr/colorPrimary"
                    android:elevation="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/timetable_period_label_width"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="节次"
                        android:textColor="#DDEBFF"
                        android:textSize="@dimen/timetable_period_text_size"
                        android:textStyle="bold" />

                    <LinearLayout style="@style/TimetableHeaderCell">
                        <TextView style="@style/TimetableHeaderDay" android:text="周一" />
                        <TextView style="@style/TimetableHeaderDate" />
                    </LinearLayout>
                    <LinearLayout style="@style/TimetableHeaderCell">
                        <TextView style="@style/TimetableHeaderDay" android:text="周二" />
                        <TextView style="@style/TimetableHeaderDate" />
                    </LinearLayout>
                    <LinearLayout style="@style/TimetableHeaderCell">
                        <TextView style="@style/TimetableHeaderDay" android:text="周三" />
                        <TextView style="@style/TimetableHeaderDate" />
                    </LinearLayout>
                    <LinearLayout style="@style/TimetableHeaderCell">
                        <TextView style="@style/TimetableHeaderDay" android:text="周四" />
                        <TextView style="@style/TimetableHeaderDate" />
                    </LinearLayout>
                    <LinearLayout style="@style/TimetableHeaderCell">
                        <TextView style="@style/TimetableHeaderDay" android:text="周五" />
                        <TextView style="@style/TimetableHeaderDate" />
                    </LinearLayout>
                    <LinearLayout style="@style/TimetableHeaderCell">
                        <TextView style="@style/TimetableHeaderDay" android:text="周六" />
                        <TextView style="@style/TimetableHeaderDate" />
                    </LinearLayout>
                    <LinearLayout style="@style/TimetableHeaderCell">
                        <TextView style="@style/TimetableHeaderDay" android:text="周日" />
                        <TextView style="@style/TimetableHeaderDate" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_timetable"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/empty_timetable"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_course"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:contentDescription="@string/add_course"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/accent"
        app:fabSize="normal"
        app:maxImageSize="24dp"
        app:tint="@android:color/white" />
</FrameLayout>
