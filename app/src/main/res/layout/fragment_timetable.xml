<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Week indicator -->
    <LinearLayout
        android:id="@+id/week_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:background="@android:color/holo_blue_dark"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_prev_week"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&lt;"
            android:textColor="@android:color/white"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <TextView
            android:id="@+id/tv_week_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_next_week"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&gt;"
            android:textColor="@android:color/white"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp" />

    </LinearLayout>

    <!-- Timetable grid inside horizontal scroll -->
    <HorizontalScrollView
        android:id="@+id/hsv_timetable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Day header row -->
            <LinearLayout
                android:id="@+id/header_row"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:background="@android:color/holo_blue_dark"
                android:elevation="2dp">

                <TextView
                    android:layout_width="@dimen/timetable_period_label_width"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="周一"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/timetable_header_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="周二"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/timetable_header_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="周三"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/timetable_header_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="周四"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/timetable_header_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="周五"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/timetable_header_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="周六"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/timetable_header_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="周日"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/timetable_header_text_size"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- RecyclerView for period rows -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_timetable"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/empty_timetable"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
