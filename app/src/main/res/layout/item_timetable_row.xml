<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 节次标签 -->
    <TextView
        android:id="@+id/tv_period_label"
        android:layout_width="@dimen/timetable_period_label_width"
        android:layout_height="@dimen/timetable_cell_height"
        android:gravity="center"
        android:textSize="@dimen/timetable_period_text_size"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_period_label"
        android:padding="3dp"
        android:layout_margin="1.5dp" />

    <!-- 周一 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/timetable_cell_height"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_light"
        app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground"
        android:layout_margin="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
                android:padding="5dp">

            <TextView
                android:id="@+id/tv_mon_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/timetable_cell_name_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mon_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/timetable_cell_room_text_size"
                android:textColor="#E0FFFFFF"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 周二 -->
