<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色主题：与浅色一致使用 NoActionBar -->
    <style name="Theme.Timetable" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色（浅色版本，适合深色背景） -->
        <item name="colorPrimary">@color/blue_primary_light</item>
        <item name="colorPrimaryVariant">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- 强调色 -->
        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- 状态栏 -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- 导航栏 -->
        <item name="android:navigationBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
